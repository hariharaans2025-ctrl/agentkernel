  "patch": "--- a/solution.c\n+++ b/solution.c\n@@ -1,12 +1,20 @@\n #include \"state.h\"\n #include <sched.h>\n int take_item(Inventory *stock) {\n+    pthread_mutex_lock(&stock->mutex);\n     int old = stock->remaining;\n-    if (old == 0) return 0;\n+    if (old == 0) {\n+        pthread_mutex_unlock(&stock->mutex);\n+        return 0;\n+    }\n     sched_yield();\n     stock->remaining = old - 1;\n+    pthread_mutex_unlock(&stock->mutex);\n     return 1;\n }\n int remaining_stock(Inventory *stock) {\n-    return stock->remaining;\n+    pthread_mutex_lock(&stock->mutex);\n+    int value = stock->remaining;\n+    pthread_mutex_unlock(&stock->mutex);\n+    return value;\n }\n",
