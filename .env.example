# Mock mode is the safe default. Set these in your shell; .env is not auto-loaded.
AGENTKERNEL_LOCAL_MOCK=true
AGENTKERNEL_LOCAL_BACKEND=ollama
AGENTKERNEL_OLLAMA_URL=http://localhost:11434
# Required for real inference; use the exact name of an already installed model.
AGENTKERNEL_LOCAL_MODEL=
# Total inference deadline in seconds, including model loading.
AGENTKERNEL_LOCAL_TIMEOUT_SECONDS=120
# Maximum attempts per execution (concurrency includes Nano triage and repair retries).
AGENTKERNEL_MAX_ATTEMPTS=4

# Concurrency inference defaults to scripted mock mode; real mode never substitutes models.
AGENTKERNEL_NEBIUS_MODE=mock
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Fill exact, case-sensitive IDs from the account catalog before real inference.
AGENTKERNEL_NEMOTRON_NANO_MODEL=
AGENTKERNEL_NEMOTRON_SUPER_MODEL=
AGENTKERNEL_NEMOTRON_ULTRA_MODEL=
# Optional JSON keyed by exact model ID: {"model-id":{"input_per_million":0.0,"output_per_million":0.0}}
# Leave empty unless real pricing is known. Unavailable pricing yields null cost.
AGENTKERNEL_NEBIUS_PRICING_JSON={}

# Opt-in observability. Only bounded allowlisted metrics/IDs are exported.
AGENTKERNEL_OBSERVABILITY=none
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=concurrency-bug-hunter
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
# Optional conditional grounding; disabled by default. Explicit diagnostic reason required.
AGENTKERNEL_TAVILY_ENABLED=false
TAVILY_API_KEY=
# Execution is remote-only. These credentials remain on the controller.
NEBIUS_PROJECT_ID=aiproject-e00z8mw0ggdmwn69nb
AGENTKERNEL_SANDBOX_IMAGE=python:3.12
